# Stage 13 local Docker configuration. Replace placeholder secrets before use.
APP_ENV=production

POSTGRES_DB=rcaa
POSTGRES_USER=rcaa
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql+psycopg://rcaa:replace-with-a-strong-local-password@postgres:5432/rcaa

AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=1
METRICS_AUTH_TOKEN=replace-with-a-random-metrics-token
MAX_REQUEST_BODY_BYTES=10485760
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_IP=60
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_SIGNUP_IP=20
RATE_LIMIT_SIGNUP_EMAIL=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_DEMO_IP=20
RATE_LIMIT_DEMO_EMAIL=5
RATE_LIMIT_DEMO_WINDOW_SECONDS=3600
# Optional defense-in-depth: comma-separated Razorpay webhook source IPs maintained from current Razorpay guidance.
RAZORPAY_WEBHOOK_ALLOWED_IPS=

# AI: mock/deterministic keeps local runs offline. External providers require AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-a-webhook-secret

SETTLEMENT_WINDOW_DAYS=3
RECONCILIATION_TIMESTAMP_TOLERANCE_MINUTES=30
RECONCILIATION_AMOUNT_TOLERANCE=0.00
RECONCILIATION_TIMEZONE=UTC

# Database connection safety.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1

# Background worker safety.
JOB_RETRY_BASE_SECONDS=1
JOB_RETRY_MAX_SECONDS=30
JOB_LEASE_SECONDS=60
JOB_POLL_SECONDS=1

# Safe release identity; never put secrets here.
RCAA_VERSION=0.14.0
BUILD_ID=local
GIT_COMMIT_SHA=unknown

# Frontend public configuration only.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Billing provider: manual or razorpay
BILLING_PROVIDER=manual
# Razorpay subscription plan IDs created in the Razorpay Dashboard/API
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_BUSINESS=

# Identity/session security.
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key
MFA_ISSUER=RCAA
# Set to ADMIN after all existing administrators have enrolled, or use the setup flow.
MFA_REQUIRED_ROLES=
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=rcaa_refresh
REFRESH_COOKIE_SECURE=1
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# Raw ingestion artifact retention. Normalized financial truth is retained separately.
UPLOAD_RETENTION_DAYS=30
RAW_DATA_RETENTION_DAYS=90

RCAA_DOMAIN=localhost

# v0.11-v0.14 launch readiness
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
PASSWORD_RESET_PUBLIC_BASE_URL=https://localhost
CONNECTOR_SYNC_DEFAULT_INTERVAL_MINUTES=360
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=120

# Enterprise OIDC/SSO
SSO_ENABLED=0
SSO_FRONTEND_URL=
SSO_CALLBACK_URL=http://localhost:3000/api/v1/auth/sso/callback
SSO_ALLOWED_ISSUERS=
SSO_STATE_EXPIRE_MINUTES=10
